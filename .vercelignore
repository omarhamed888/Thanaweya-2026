# This is a static, analytics-only deployment (see vercel.json: outputDirectory
# is "frontend"). None of this is needed on Vercel, and data/ in particular
# must never be uploaded — it holds the full 919k-student SQLite DB + raw
# workbook caches, which is exactly the bulk student data this deployment is
# built to keep off the public internet.
data/
.claude/
docs/
backend/
pipeline/
*.pkl
*.db
__pycache__/
.venv/
venv/
*.xlsx
