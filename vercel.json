{
  "framework": null,
  "buildCommand": null,
  "installCommand": "npm install",
  "outputDirectory": "frontend",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/analytics", "destination": "/data/analytics.json" },
    { "source": "/api/predictions", "destination": "/data/predictions.json" },
    { "source": "/api/quality", "destination": "/data/data_quality_report.json" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
